# Tollugatti Mobile - Local Development Endpoints

# Auth portal
EXPO_PUBLIC_AUTH_URL=http://localhost:3001
# Auth redirect entry path
EXPO_PUBLIC_AUTH_LOGIN_PATH=/login
# App deep-link scheme used for auth callback
EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=tollugatti
# Auth APIs used post-redirect
EXPO_PUBLIC_AUTH_MOBILE_AUTHORIZE_PATH=/api/auth/mobile/authorize
EXPO_PUBLIC_AUTH_MOBILE_EXCHANGE_PATH=/api/auth/mobile/exchange
EXPO_PUBLIC_AUTH_LOGOUT_PATH=/api/auth/logout
EXPO_PUBLIC_AUTH_ME_PATH=/api/me
EXPO_PUBLIC_AUTH_PROFILE_PATH=/api/profile

# API server
EXPO_PUBLIC_API_URL=http://localhost:3000

# boardgame.io game server
EXPO_PUBLIC_GAME_SERVER_URL=http://localhost:8000

# boardgame.io lobby server
EXPO_PUBLIC_LOBBY_SERVER_URL=http://localhost:8080
